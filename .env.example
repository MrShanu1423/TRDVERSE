# Live execution kill switch (keep false until tested on testnet / small size)
BROKER_EXECUTION_ENABLED=false
# The Binance/Angel keys below are ONE person's real account. Every signed-up user shares this server,
# so without OWNER_ID set to YOUR login id (the email or +91 phone you OTP-login with), nobody - not even you -
# can reach real balances/orders. Required before BROKER_EXECUTION_ENABLED can do anything.
OWNER_ID=
# Binance USDS-M Futures (testnet: https://testnet.binancefuture.com)
BINANCE_BASE=https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_PUBLIC_IP=
# --- Wallet withdrawals: real TESTNET broadcast for ETH (Sepolia) + BNB (BSC testnet) only ---
# Generate a dedicated key (e.g. `new ethers.Wallet.createRandom()`) - NEVER reuse a mainnet/real-funds key here.
# Fund the resulting address from a public faucet (search "sepolia eth faucet" / "bsc testnet faucet").
# Every other coin/network (BTC, USDT, TRX, SOL, LTC, DOGE) stays paper-only regardless of this key.
TESTNET_EVM_PRIVATE_KEY=
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Email OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Mobile OTP via any SMS gateway relay (MSG91 / Twilio / Fast2SMS). Gets POST {to, message}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Live market data (public, no key needed) ---
# BINANCE_REST=https://api.binance.com        # override only for tests/proxies
# USD_INR_FALLBACK=88                         # used only if Binance's USDT/INR pair is unavailable
# Angel One instrument list is downloaded automatically (ANGEL_MASTER_URL to override)

# --- Add money via Razorpay UPI QR (owner's account) ---
# Dashboard > Settings > Webhooks: URL https://<your-domain>/api/pay/razorpay/webhook, event "qr_code.credited", set a secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Testing only: lets users add pretend money without Razorpay. Keep false in production.
DEMO_CREDIT=false
# Testing only: allow stock paper orders outside NSE hours
ALLOW_OFF_HOURS_STOCK=false

# --- Database: Firebase Firestore (server-side only; see FIREBASE-SETUP.md) ---
# base64 of the service-account JSON:   base64 -w0 serviceAccountKey.json   (Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json")))
FIREBASE_SERVICE_ACCOUNT_B64=
# optional: collection name prefix (default tv_)
# FIRESTORE_PREFIX=tv_
# optional local-testing alternative (no Firebase): STORE_FILE=./tradeverse-data.json
